{
  "name": "translation-tool-afop",
  "private": false,
  "version": "1.0.0-beta",
  "author": {
    "name": "Palkxarunä / swappel",
    "email": "swappelmail@gmail.com",
    "url": "https://swappel.de/"
  },
  "description": "An app to facilitate the editing of localization files from Avatar: Frontiers of Pandora",
  "keywords": [
    "tool",
    "AFoP",
    "A:FoP",
    "FoP",
    "Avatar: Frontiers of Pandora",
    "translation",
    "localization",
    "editing",
    "files",
    "locpack",
    "locpackbin"
  ],
  "homepage": "https://github.com/swappel/translation-tool-afop",
  "licence": "GPL-3.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:addon": "git submodule update --remote && npx cmake-js compile --directory ./backend",
    "build:app": "npm run build && npm run build:addon && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "start_el": "electron ./"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gsap/react": "^2.1.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "cmake-js": "^8.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "gsap": "^3.15.0",
    "json-server": "^1.0.0-beta.15",
    "node-addon-api": "^8.9.2",
    "sass": "^1.105.1",
    "scss": "^0.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "de.swappel.afopTransapp",
    "productName": "A:FoP Localization Tool",
    "directories": {
      "output": "dist_app"
    },
    "files": [
      "main.cjs",
      "preload.js",
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/build/Release/FoPTransApp_Final.node",
        "to": "FoPTransApp_Final.node"
      }
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
